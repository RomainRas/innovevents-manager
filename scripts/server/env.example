# Configuration du serveur de production : copier en .env (non versionné) et compléter.
SITE_DOMAIN=innovevents.example.fr
# Adresse qui reçoit les notifications de l'agence (nouvelle demande, devis accepté).
AGENCY_EMAIL=contact@example.fr
# Expéditeur des courriels de l'application.
MAIL_FROM=contact@example.fr
# SMTP réel : laisser vide pour garder la boîte de secours Mailpit (aucun courriel ne sort).
# Exemple Hostinger : SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_SECURE=ssl, SMTP_USER=contact@example.fr
# Le mot de passe de la boîte se place uniquement dans .secrets/smtp-password.txt sur le serveur.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
