# Image de production : PHP-FPM (pas le serveur intégré de développement), code et dépendances inclus.
FROM composer:2@sha256:8de2184c6de224f4689e8f80ed5f5edaf0030b6b8b7839a22a2bcb6722ac87d0 AS composer

FROM php:8.4-fpm-bookworm AS base
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev pkg-config unzip libpng-dev libjpeg62-turbo-dev libxml2-dev libonig-dev \
    && docker-php-ext-configure gd --with-jpeg \
    && docker-php-ext-install pdo_mysql gd dom mbstring opcache \
    && pecl install mongodb-2.5.7 \
    && docker-php-ext-enable mongodb \
    && rm -rf /var/lib/apt/lists/*

FROM base AS vendor
COPY --from=composer /usr/bin/composer /usr/local/bin/composer
WORKDIR /app
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --no-interaction --no-scripts --prefer-dist --classmap-authoritative --no-autoloader \
    && rm -rf /root/.composer
COPY backend/src ./src
RUN composer dump-autoload --no-dev --classmap-authoritative

FROM base
COPY docker/php/php-prod.ini /usr/local/etc/php/conf.d/zz-innovevents.ini
COPY docker/php/fpm-pool.conf /usr/local/etc/php-fpm.d/zz-innovevents.conf
WORKDIR /app
COPY --from=vendor /app/vendor ./vendor
COPY backend/src ./src
COPY backend/public ./public
COPY backend/bin ./bin
COPY backend/demo-images ./demo-images
# Stockage privé (sessions, PDF, images) monté en volume ; propriétaire = utilisateur PHP-FPM.
RUN mkdir -p /var/lib/innovevents && chown www-data:www-data /var/lib/innovevents && chmod 700 /var/lib/innovevents
EXPOSE 9000
CMD ["php-fpm"]
