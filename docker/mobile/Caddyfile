# Serveur interne de l'application mobile : fichiers statiques sous /mobile/, sans HTTPS (réseau Docker privé).
{
	auto_https off
	admin off
}
:8080 {
	root * /srv
	encode zstd gzip
	# Le service worker et le manifeste doivent toujours être relus pour diffuser les mises à jour.
	@fresh path /mobile/sw.js /mobile/manifest.webmanifest /mobile/ /mobile/index.html
	header @fresh Cache-Control "no-cache"
	@assets path /mobile/assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /mobile/manifest.webmanifest Content-Type "application/manifest+json"
	handle /mobile/* {
		try_files {path} /mobile/index.html
		file_server
	}
	handle {
		redir * /mobile/ 308
	}
}
